<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".ui.toolsFragment.ToolsFragment"
    android:background="@color/background">

   <androidx.constraintlayout.widget.ConstraintLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content">
       <androidx.constraintlayout.widget.ConstraintLayout
           android:id="@+id/cl_toolbar"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:background="@color/white"
           android:padding="8dp"
           app:layout_constraintTop_toTopOf="parent"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent">

           <ImageButton
               android:id="@+id/button_setting"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@drawable/ic_settings"
               android:background="@android:color/transparent"
               android:padding="5dp"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent" />

           <TextView
               android:id="@+id/toolbar_title"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:text="Fast PDF Scanner"
               android:textColor="@color/black"
               android:textStyle="bold"
               android:textSize="20sp"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent"
               app:layout_constraintStart_toStartOf="parent"
               app:layout_constraintEnd_toEndOf="parent" />

           <ImageButton
               android:id="@+id/button_checklist"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@drawable/ic_checklist"
               android:background="@android:color/transparent"
               android:padding="5dp"
               app:layout_constraintEnd_toEndOf="parent"
               app:layout_constraintTop_toTopOf="parent"
               app:layout_constraintBottom_toBottomOf="parent" />
       </androidx.constraintlayout.widget.ConstraintLayout>
       <TextView
           android:id="@+id/tv_conversions"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Conversions"
           android:textSize="20sp"
           android:textStyle="bold"
           android:textColor="@color/black"
           android:layout_margin="20dp"
           app:layout_constraintTop_toBottomOf="@+id/cl_toolbar"/>
       <LinearLayout
           android:id="@+id/ll_cartitem1"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           app:layout_constraintTop_toBottomOf="@+id/tv_conversions"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent">
           <com.google.android.material.card.MaterialCardView
               android:layout_width="0dp"
               android:layout_weight="1"
               android:layout_height="140dp"
               android:background="@color/white"
               android:layout_margin="8dp"
               app:cardCornerRadius="15dp">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Convert PDF to Word"
                   android:textStyle="bold"
                   android:textSize="22sp"
                   android:layout_marginBottom="20dp"
                   android:padding="8dp"
                   android:layout_gravity="bottom"/>
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="70dp"
                   android:src="@drawable/word"
                   android:paddingEnd="10dp"
                   android:layout_gravity="end"/>
           </com.google.android.material.card.MaterialCardView>
           <com.google.android.material.card.MaterialCardView
               android:layout_width="0dp"
               android:layout_weight="1"
               android:layout_height="140dp"
               android:background="@color/white"
               android:layout_margin="8dp"
               app:cardCornerRadius="15dp">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Convert PDF to FB2"
                   android:textStyle="bold"
                   android:textSize="22sp"
                   android:layout_marginBottom="20dp"
                   android:padding="8dp"
                   android:layout_gravity="bottom"/>
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="70dp"
                   android:src="@drawable/fb2"
                   android:paddingEnd="10dp"
                   android:layout_gravity="end"/>
           </com.google.android.material.card.MaterialCardView>

       </LinearLayout>
       <LinearLayout
           android:id="@+id/ll_cartitem2"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           app:layout_constraintTop_toBottomOf="@+id/ll_cartitem1"
           app:layout_constraintStart_toStartOf="parent"
           app:layout_constraintEnd_toEndOf="parent">
           <com.google.android.material.card.MaterialCardView
               android:layout_width="0dp"
               android:layout_weight="1"
               android:layout_height="140dp"
               android:background="@color/white"
               android:layout_margin="8dp"
               app:cardCornerRadius="15dp">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Convert PDF to EPUB"
                   android:textStyle="bold"
                   android:textSize="22sp"
                   android:layout_marginBottom="20dp"
                   android:padding="8dp"
                   android:layout_gravity="bottom"/>
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="70dp"
                   android:src="@drawable/epub"
                   android:paddingEnd="10dp"
                   android:layout_gravity="end"/>
           </com.google.android.material.card.MaterialCardView>
           <com.google.android.material.card.MaterialCardView
               android:layout_width="0dp"
               android:layout_weight="1"
               android:layout_height="140dp"
               android:background="@color/white"
               android:layout_margin="8dp"
               app:cardCornerRadius="15dp">
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="Convert PDF to Image"
                   android:textStyle="bold"
                   android:textSize="22sp"
                   android:layout_marginBottom="20dp"
                   android:padding="8dp"
                   android:layout_gravity="bottom"/>
               <ImageView
                   android:layout_width="50dp"
                   android:layout_height="70dp"
                   android:src="@drawable/photo"
                   android:paddingEnd="10dp"
                   android:layout_gravity="end"/>
           </com.google.android.material.card.MaterialCardView>

       </LinearLayout>
       <TextView
           android:id="@+id/tv_enhanced"
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:text="Enhanced"
           android:textStyle="bold"
           android:textSize="18sp"
           android:layout_margin="20dp"
           app:layout_constraintTop_toBottomOf="@+id/ll_cartitem2"/>
       <com.google.android.material.card.MaterialCardView
           android:layout_width="match_parent"
           android:layout_height="265dp"
           android:layout_marginStart="10dp"
           android:layout_marginEnd="10dp"
           android:layout_marginTop="10dp"
           app:cardCornerRadius="12dp"
           app:layout_constraintTop_toBottomOf="@+id/tv_enhanced">

           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:orientation="vertical">
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal">
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_merge"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/merge"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_mergepdf"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Merge PDF"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_page"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/page"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_extractpage"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Extract Pages"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_reorder"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/reorder"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_reorderpage"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Reorder Pages"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
               </LinearLayout>
               <LinearLayout
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:orientation="horizontal">
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_password"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/password"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_password"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Password"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_watermark"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/watermark"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_watermark"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Watermark"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
                   <LinearLayout
                       android:layout_width="0dp"
                       android:layout_weight="1"
                       android:layout_height="wrap_content"
                       android:orientation="vertical"
                       android:layout_margin="10dp">
                       <androidx.cardview.widget.CardView
                           android:layout_width="wrap_content"
                           android:layout_height="wrap_content"
                           app:cardCornerRadius="50dp"
                           android:layout_gravity="center">
                           <ImageView
                               android:id="@+id/iv_qr_code"
                               android:layout_width="60dp"
                               android:layout_height="60dp"
                               android:src="@drawable/qr_code"/>
                       </androidx.cardview.widget.CardView>
                       <TextView
                           android:id="@+id/tv_categoryName"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:text="Scan qr Code"
                           android:textSize="18sp"
                           android:textColor="@color/black"
                           android:textStyle="bold"
                           android:gravity="center"
                           android:padding="5dp"/>

                   </LinearLayout>
               </LinearLayout>
           </LinearLayout>

       </com.google.android.material.card.MaterialCardView>

   </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>